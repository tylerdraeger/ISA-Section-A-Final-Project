  <worksheets>
    <worksheet name="Occupancy Trend">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Net-lease REITs stay almost fully leased; shopping centers keep climbing
</run><run fontsize='10' fontcolor='#555555'>Average occupancy by property type, quarterly, 2023-2026 (from earnings press releases)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='federated.reitquarterly01' />
          </datasources>
          <datasource-dependencies datasource='federated.reitquarterly01'>
            <column caption="Property Type" datatype='string' name='[property_group]' role='dimension' type='nominal' />
            <column caption="Quarter" datatype='date' name='[quarter_end]' role='dimension' type='ordinal' />
            <column caption="Occupancy (%)" datatype='real' name='[occupancy_pct]' role='measure' type='quantitative' />
            <column-instance column='[occupancy_pct]' derivation='Avg' name='[avg:occupancy_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[quarter_end]' derivation='Quarter-Trunc' name='[tqr:quarter_end:qk]' pivot='key' type='quantitative' />
            <column-instance column='[property_group]' derivation='None' name='[none:property_group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.reitquarterly01].[none:property_group:nk]'><groupfilter function='level-members' level='[none:property_group:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          
          <slices><column>[federated.reitquarterly01].[none:property_group:nk]</column></slices>
          <aggregation value='true' />
        </view>
        <style><style-rule element='axis'><format attr='title' class='0' field='[federated.reitquarterly01].[avg:occupancy_pct:qk]' scope='rows' value="Average occupancy (%)" /><format attr='title' class='0' field='[federated.reitquarterly01].[tqr:quarter_end:qk]' scope='cols' value="Quarter" /></style-rule></style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.reitquarterly01].[none:property_group:nk]' />
            </encodings>
            
          </pane>
        </panes>
        <rows>[federated.reitquarterly01].[avg:occupancy_pct:qk]</rows>
        <cols>[federated.reitquarterly01].[tqr:quarter_end:qk]</cols>
      </table>
      <simple-id uuid='{3BE14B88-1861-4B90-8A1B-CFB684A923BE}' />
    </worksheet>
    <worksheet name="NOI Growth Trend">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Shopping centers grow rent from the same properties faster than malls
</run><run fontsize='10' fontcolor='#555555'>Average year-over-year same-property NOI growth by property type (net-lease REITs do not report it)</run>
          </formatted-text>
        </title>
