  <worksheets>
    <worksheet name='1-Year Return vs Treasury'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>20 of 24 retail REITs beat a 10-year Treasury last year, but net-lease REITs barely did
</run>
            <run fontcolor='#555555' fontsize='10'>Bars: 1-year total return (as of Nov 13, 2026) with the 10-year Treasury yield from a year earlier inside (dark bar). Bottom line: return above the Treasury, in percentage points.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retail REIT profiles' name='federated.reitprofiles001' />
          </datasources>
          <datasource-dependencies datasource='federated.reitprofiles001'>
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column caption='Return Above Treasury (pts)' datatype='real' name='[excess_return_1yr_pct]' role='measure' type='quantitative' />
            <column-instance column='[company]' derivation='None' name='[none:company:nk]' pivot='key' type='nominal' />
            <column-instance column='[property_group]' derivation='None' name='[none:property_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[ticker]' derivation='None' name='[none:ticker:nk]' pivot='key' type='nominal' />
            <column caption='Property Type' datatype='string' name='[property_group]' role='dimension' type='nominal' />
            <column caption='1-Year Total Return (%)' datatype='real' name='[return_1yr_pct]' role='measure' type='quantitative' />
            <column-instance column='[excess_return_1yr_pct]' derivation='Sum' name='[sum:excess_return_1yr_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[return_1yr_pct]' derivation='Sum' name='[sum:return_1yr_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[treasury_10y_1yr_ago]' derivation='Sum' name='[sum:treasury_10y_1yr_ago:qk]' pivot='key' type='quantitative' />
            <column caption='Ticker' datatype='string' name='[ticker]' role='dimension' type='nominal' />
            <column caption='10-Yr Treasury Yield a Year Ago (%)' datatype='real' name='[treasury_10y_1yr_ago]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.reitprofiles001].[none:property_group:nk]'>
            <groupfilter function='level-members' level='[none:property_group:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.reitprofiles001].[none:ticker:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.reitprofiles001].[sum:return_1yr_pct:qk]' shelf='columns' />
          </shelf-sorts>
          <slices>
            <column>[federated.reitprofiles001].[none:property_group:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.reitprofiles001].[sum:treasury_10y_1yr_ago:qk]' field-type='quantitative' fold='true' scope='rows' synchronized='true' type='space' />
            <format attr='title' class='0' field='[federated.reitprofiles001].[sum:return_1yr_pct:qk]' scope='rows' value='1-year total return (%)' />
            <format attr='title' class='0' field='[federated.reitprofiles001].[sum:excess_return_1yr_pct:qk]' scope='rows' value='Above Treasury (pts)' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.reitprofiles001].[sum:return_1yr_pct:qk]' value='n#,##0.0;-#,##0.0' />
            <format attr='text-format' field='[federated.reitprofiles001].[sum:excess_return_1yr_pct:qk]' value='n#,##0.0;-#,##0.0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.reitprofiles001].[sum:return_1yr_pct:qk]'>
            <view>
              <breakdown value='auto' />
