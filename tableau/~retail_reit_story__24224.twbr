      <simple-id uuid='{2AE09F59-2A04-4380-9299-05CEA7D80D4C}' />
    </worksheet>
    <worksheet name='Returns vs Rates'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>REIT returns drop when the 10-year Treasury rises, and net lease gets hit hardest
</run>
            <run fontcolor='#555555' fontsize='10'>Average quarterly stock total return by property type, grouped by how much the 10-year Treasury yield moved that quarter (2023-2026: 4 quarters fell 25+ bp, 6 were flat, 5 rose 25+ bp)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retail REIT quarterly' name='federated.reitquarterly01' />
          </datasources>
          <datasource-dependencies datasource='federated.reitquarterly01'>
            <column-instance column='[total_return_q_pct]' derivation='Avg' name='[avg:total_return_q_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[property_group]' derivation='None' name='[none:property_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[rate_move]' derivation='None' name='[none:rate_move:nk]' pivot='key' type='nominal' />
            <column caption='Property Type' datatype='string' name='[property_group]' role='dimension' type='nominal' />
            <column caption='10-Yr Treasury Move' datatype='string' name='[rate_move]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [treasury_10y_change_bp] &gt; 25 THEN &quot;Rates rose 25+ bp&quot; ELSEIF [treasury_10y_change_bp] &lt; -25 THEN &quot;Rates fell 25+ bp&quot; ELSE &quot;Rates flat (within 25 bp)&quot; END' />
            </column>
            <column caption='Quarterly Total Return (%)' datatype='real' name='[total_return_q_pct]' role='measure' type='quantitative' />
            <column caption='Change in 10-Yr Treasury (bp)' datatype='real' name='[treasury_10y_change_bp]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.reitquarterly01].[none:property_group:nk]'>
            <groupfilter function='level-members' level='[none:property_group:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.reitquarterly01].[none:property_group:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.reitquarterly01].[avg:total_return_q_pct:qk]' scope='rows' value='Avg quarterly total return (%)' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.reitquarterly01].[avg:total_return_q_pct:qk]' value='n#,##0.0;-#,##0.0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.reitquarterly01].[none:property_group:nk]' />
              <text column='[federated.reitquarterly01].[avg:total_return_q_pct:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.reitquarterly01].[avg:total_return_q_pct:qk]</rows>
        <cols>([federated.reitquarterly01].[none:rate_move:nk] / [federated.reitquarterly01].[none:property_group:nk])</cols>
      </table>
      <simple-id uuid='{8EF0B5AF-28AA-44E1-B135-ADD05F952CFF}' />
    </worksheet>
    <worksheet name='Valuation vs Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Growth alone does not set the price: most REITs trade at 12-16x FFO, and malls are the cheapest
</run>
            <run fontcolor='#555555' fontsize='10'>Each dot is one REIT: typical (median) FFO-per-share growth vs. a year earlier, and average price / annualized FFO, 2024-2026</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retail REIT quarterly' name='federated.reitquarterly01' />
          </datasources>
          <datasource-dependencies datasource='federated.reitquarterly01'>
            <column-instance column='[price_to_ffo]' derivation='Avg' name='[avg:price_to_ffo:qk]' pivot='key' type='quantitative' />
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column datatype='real' name='[ffo_growth_yoy_pct]' role='measure' type='quantitative' />
            <column-instance column='[ffo_growth_yoy_pct]' derivation='Median' name='[med:ffo_growth_yoy_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[company]' derivation='None' name='[none:company:nk]' pivot='key' type='nominal' />
            <column-instance column='[property_group]' derivation='None' name='[none:property_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[ticker]' derivation='None' name='[none:ticker:nk]' pivot='key' type='nominal' />
            <column caption='Price / FFO' datatype='real' name='[price_to_ffo]' role='measure' type='quantitative' />
            <column caption='Property Type' datatype='string' name='[property_group]' role='dimension' type='nominal' />
            <column caption='Ticker' datatype='string' name='[ticker]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.reitquarterly01].[none:property_group:nk]'>
            <groupfilter function='level-members' level='[none:property_group:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.reitquarterly01].[none:property_group:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.reitquarterly01].[avg:price_to_ffo:qk]' scope='rows' value='Price / FFO (x)' />
            <format attr='title' class='0' field='[federated.reitquarterly01].[med:ffo_growth_yoy_pct:qk]' scope='cols' value='Median FFO per share growth, year over year (%)' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.reitquarterly01].[none:property_group:nk]' />
              <text column='[federated.reitquarterly01].[none:ticker:nk]' />
              <lod column='[federated.reitquarterly01].[none:company:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.reitquarterly01].[avg:price_to_ffo:qk]</rows>
        <cols>[federated.reitquarterly01].[med:ffo_growth_yoy_pct:qk]</cols>
      </table>
      <simple-id uuid='{55A31252-AC7A-4808-AA08-C61C511BF5BF}' />
    </worksheet>
