            <format attr='title' class='0' field='[federated.reitquarterly01].[avg:occupancy_pct:qk]' scope='rows' value='Average occupancy (%)' />
            <format attr='title' class='0' field='[federated.reitquarterly01].[tqr:quarter_end:qk]' scope='cols' value='Quarter' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
