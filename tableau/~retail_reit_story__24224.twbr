    <worksheet name='REITs by Property Type'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>24 retail REITs, grouped by what they own
</run>
            <run fontcolor='#555555' fontsize='10'>Each block is one REIT: 12 shopping center, 8 net lease, 4 mall/outlet</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Retail REIT profiles' name='federated.reitprofiles001' />
          </datasources>
          <datasource-dependencies datasource='federated.reitprofiles001'>
            <column-instance column='[property_group]' derivation='None' name='[none:property_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[ticker]' derivation='None' name='[none:ticker:nk]' pivot='key' type='nominal' />
            <column caption='Property Type' datatype='string' name='[property_group]' role='dimension' type='nominal' />
            <column caption='Number of REITs' datatype='integer' name='[reit_count]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column-instance column='[reit_count]' derivation='Sum' name='[sum:reit_count:qk]' pivot='key' type='quantitative' />
            <column caption='Ticker' datatype='string' name='[ticker]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.reitprofiles001].[none:property_group:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.reitprofiles001].[sum:reit_count:qk]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.reitprofiles001].[sum:reit_count:qk]' scope='cols' value='Number of REITs' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.reitprofiles001].[none:property_group:nk]' />
              <text column='[federated.reitprofiles001].[none:ticker:nk]' />
              <lod column='[federated.reitprofiles001].[none:ticker:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
              </style-rule>
            </style>
